# ============================================================================
# Gemini-Scout: Tactical Match Analysis Pipeline
# Copy this file to .env and fill in your actual API keys
# ============================================================================

# ============================================================================
# ROCKETRIDE CORE
# ============================================================================
# Your RocketRide instance URL (Optional if using local engine)
ROCKETRIDE_URI=http://localhost:5565

# Your RocketRide API key
ROCKETRIDE_APIKEY=MY_API_KEY

# ============================================================================
# REQUIRED API KEYS
# ============================================================================
# Google Gemini API key (Required for Agent reasoning and LLM nodes)
ROCKETRIDE_GEMINI_API_KEY=your-gemini-api-key

# Firecrawl API key (Required for web search and scraping)
ROCKETRIDE_FIRECRAWL_API_KEY=your-firecrawl-api-key

# ============================================================================
# NOTES
# ============================================================================
# 1. All ROCKETRIDE_* variables support substitution in pipeline configs using ${VARIABLE}
# 2. Never commit .env file to git (it's already in .gitignore)
# 3. Variable names are case-sensitive
